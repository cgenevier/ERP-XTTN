{
    "dataset_name": "ERP CORE LRP",
    "description": "Lateralized Readiness Potential from flanker task. 40 neurotypical adults. Part of the ERP CORE project (Kappenman et al., 2021).",
    "citation": "Kappenman, E. S., Farrens, J. L., Zhang, W., Stewart, A. X., & Luck, S. J. (2021). ERP CORE: An open resource for human event-related potential research. NeuroImage, 225, 117465.",
    "input_format": "eeglab",
    "file_glob": "*/*_eeg.set",
