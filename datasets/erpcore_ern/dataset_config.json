        "sub-34",
        "sub-35",
        "sub-36",
        "sub-37",
        "sub-38",
        "sub-39",
        "sub-40"
    ],
    "variants": {
        "midline3_ern": "noref_midline3_ern_rs256_iir_fwd_bp-1-10",
        "full": "noref_rs256_iir_fwd_bp-1-10"
    },
    "label_map": {
        "pos_key": "error",
        "neg_key": "correct"
    },
    "label_groups": {
        "error": [
            "resp_left_compat_right",
            "resp_left_incompat_right",
            "resp_right_compat_left",
            "resp_right_incompat_left"
        ],
        "correct": [
            "resp_left_compat_left",
