{
    "dataset_name": "ERP CORE ERN",
    "description": "Error-Related Negativity from flanker task. 40 neurotypical adults. Part of the ERP CORE project (Kappenman et al., 2021).",
    "citation": "Kappenman, E. S., Farrens, J. L., Zhang, W., Stewart, A. X., & Luck, S. J. (2021). ERP CORE: An open resource for human event-related potential research. NeuroImage, 225, 117465.",
    "input_format": "eeglab",
    "file_glob": "*/*_eeg.set",
    "filename_regex": "^sub-(?P<sub>\\d+)_ses-(?P<ses>[^_]+)_task-[^_]+_eeg\\.set$",
    "channel_type": "eeg",
    "eog_channels": [
        "HEOG_left",
        "HEOG_right",
        "VEOG_lower"
    ],
    "assume_microvolts": false,
    "montage": "standard_1020",
    "bids_task": "ern",
    "export_mode": "single",
    "event_id": {
        "stim_compat_left": "11",
        "stim_compat_right": "12",
        "stim_incompat_left": "21",
        "stim_incompat_right": "22",
        "resp_left_compat_left": "111",
        "resp_left_compat_right": "112",
        "resp_left_incompat_left": "121",
        "resp_left_incompat_right": "122",
        "resp_right_compat_left": "211",
        "resp_right_compat_right": "212",
        "resp_right_incompat_left": "221",
        "resp_right_incompat_right": "222"
    },
    "epoching": {
        "mode": "event_lock",
        "event_subset": [
            "resp_left_compat_left",
            "resp_left_incompat_left",
            "resp_right_compat_right",
            "resp_right_incompat_right",
            "resp_left_compat_right",
            "resp_left_incompat_right",
            "resp_right_compat_left",
            "resp_right_incompat_left"
        ]
    },
    "notes": "EEGLAB .set/.fdt format. 33 channels (28 EEG + 2 HEOG + 1 VEOG + 2 reference). Recorded at 1024 Hz. Flanker task: subjects respond to center arrow direction while ignoring flanking arrows. Response codes: 1st digit = hand (1=left, 2=right), 2nd digit = compatibility (1=compatible, 2=incompatible), 3rd digit = target direction (1=left, 2=right). Correct responses: hand matches target (111, 121, 212, 222). Error responses: hand mismatches target (112, 122, 211, 221). ERN expected at FCz/Cz, 0-100ms post-response, more negative for errors.",
    "dataset_id": "erpcore_ern",
    "subjects": [
        "sub-01",
        "sub-02",
        "sub-03",
        "sub-04",
        "sub-05",
        "sub-06",
