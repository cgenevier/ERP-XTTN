{
    "dataset_name": "ERP CORE N2pc",
    "description": "N2pc attention component from visual search task. 40 neurotypical adults. Part of the ERP CORE project (Kappenman et al., 2021).",
    "citation": "Kappenman, E. S., Farrens, J. L., Zhang, W., Stewart, A. X., & Luck, S. J. (2021). ERP CORE: An open resource for human event-related potential research. NeuroImage, 225, 117465.",
    "input_format": "eeglab",
    "file_glob": "*/*_eeg.set",
    "filename_regex": "^sub-(?P<sub>\\d+)_ses-(?P<ses>[^_]+)_task-[^_]+_eeg\\.set$",
    "channel_type": "eeg",
    "eog_channels": [
        "HEOG_left",
        "HEOG_right",
        "VEOG_lower"
    ],
    "assume_microvolts": false,
    "montage": "standard_1020",
    "bids_task": "n2pc",
    "export_mode": "single",
    "event_id": {
        "blue_left_top": "111",
        "blue_left_bottom": "112",
        "blue_right_top": "121",
        "blue_right_bottom": "122",
        "pink_left_top": "211",
        "pink_left_bottom": "212",
        "pink_right_top": "221",
        "pink_right_bottom": "222",
        "correct_response": "201",
        "incorrect_response": "202"
    },
    "epoching": {
        "mode": "event_lock",
        "event_subset": [
            "blue_left_top",
            "blue_left_bottom",
            "blue_right_top",
            "blue_right_bottom",
            "pink_left_top",
            "pink_left_bottom",
            "pink_right_top",
            "pink_right_bottom"
        ]
    },
    "notes": "EEGLAB .set/.fdt format. 33 channels. Visual search: find target color among distractors and report gap position. Codes: 1st digit = target color (1=blue, 2=pink), 2nd digit = target side (1=left, 2=right), 3rd digit = gap position (1=top, 2=bottom). For N2pc classification: target left (x1x) vs target right (x2x). N2pc expected at PO7/PO8/P7/P8, 200-350ms post-stimulus, more negative contralateral to target.",
    "dataset_id": "erpcore_n2pc",
    "subjects": [
